{
  "name": "@local/dsh-hyprscope",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Native, plug-and-play DSH plugin for hyprscope: Hyprland desktop observation and consent-gated control.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "message.js",
    "annotate.js",
    "voice.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "test"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "linux"
      ]
    }
  },
  "license": "MIT"
}